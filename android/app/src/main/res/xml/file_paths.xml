<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths for sharing/camera assets.
     Scope strictly to the app's own external media directories and cache —
     exposing the whole external storage root (".") would hand FileProvider
     URIs to the entire SD card to any app that can launch our provider. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="Android/data/com.lifehub.app/files/Pictures" />
    <external-path name="my_documents" path="Android/data/com.lifehub.app/files/Documents" />
    <cache-path name="my_cache_images" path="." />
</paths>