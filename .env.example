# ─────────────────────────────────────────────────────────────────────────
# LifeHub environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────

# Firebase (public identifiers — safe to commit, required for the app to run)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Assistant external model (non-secret)
VITE_ASSISTANT_MODEL=google/gemma-4-31b-it:free

# ── Server-only secrets (NO VITE_ prefix → never sent to the browser) ──
# These are read by the server-side proxy (src/routes/api/assistant.ts) via
# process.env / import.meta.env on the SSR build.
#
# Local dev: put them in .env (dev-only loading is configured in vite.config.ts)
# Production (Cloudflare Workers): set them as worker secrets/bindings or
# Lovable environment variables. See README.

ASSISTANT_API_KEY=sk-or-v1-...   # OpenRouter API key — KEEP SECRET
ASSISTANT_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
